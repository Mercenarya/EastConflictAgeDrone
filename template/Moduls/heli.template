
[core]
tags: fx,AirFHT
class: CustomUnitMetadata
isBio: true
isBug: false
#isUnrepairableUnit: true
selfRegenRate: 0.01
softCollisionOnAll: 3
hideScorchMark: true




#----------------!!!------------------#


[action_showFHTCount]
#infoOnly: true
addResources: FHT=1
price:  FHT=1
text: ЛТЦ/ДО
displayType: none
buildSpeed: 0s
pos: 0.1
displayRemainingStockpile: true
highPriorityQueue: true
isActive:false

[action_trigger_FHT]
autoTrigger: if self.resource(type='EnemyIsBack', equalTo=0)
resourceAmount: EnemyIsBack
resourceAmount_setValue:1
fireTurretXAtGround:FHT
fireTurretXAtGround_withProjectile:FalseHeatTarget
fireTurretXAtGround_withOffset:0,0
fireTurretXAtGround_count:2
isVisible:false
buildSpeed: 0.5s
pos: 0.1


[turret_FHT]
x:0
y:-90
canShoot:false
#interceptProjectiles_withTags:tow
projectile:FalseHeatTarget
shoot_flame:none
image:ROOT:/PNG/null.png
attachedTo:Sensor

[projectile_FalseHeatTarget]
image:ROOT:/PNG/null.png
life:500
speed:10
directDamage:500
spawnUnit:falseTargetAirR,falseTargetAirL
explodeEffect:none

[resource_EnemyIsBack]
displayName: FHTwork
hidden: true

[hiddenAction_start]
autoTriggerOnEvent: created
addResources: FHT=20,EnemyIsBack=1


[effect_teplo] 
life: 2000
image: ROOT:/PNG/teplo.png 
color: #CCCCDD 

total_frames: 12

priority: verylow 
 
attachedToUnit: false
atmospheric: true 
physics: false 
physicsGravity: 0 
 
xOffsetRelative: 0
yOffsetRelative: -50
xSpeedRelative: 0
ySpeedRelative: 0 

scaleFrom: 1.5
scaleTo: 1.5
alpha: 1
 
animateFrameStart:0
animateFrameEnd:11
animateFrameSpeed:0.2





[turret_Sensor]
#anti-rocket
x: 0
y: 10

invisible: true

canAttackFlyingUnits: false
canAttackLandUnits:   false
interceptProjectiles_withTags: missile
interceptProjectiles_andUnderDistance: 300
projectile: Sensor
turnSpeed: 40

resourceUsage: FHT=2,EnemyIsBack=1
shoot_flame: CUSTOM:teplo


[projectile_Sensor]
#anti-rocket
directDamage: 1

life: 1
targetSpeed: 1
targetSpeedAcceleration:0.05

frame: 1
areaExpandTime:75
deflectionPower:-1
lightCastOnGround: true



[hiddenAction_FHTIncoming]
autoTrigger: if not self.isFlying() and self.resource(type='FHT',lessThan=20) and self.queueSize(lessThan=1) and self.hasParent(withTag="Helipad")
alsoQueueAction:LoadFHT

[hiddenAction_LoadFHT]
buildSpeed: 0.3s
addResources:  FHT=1



[action_trigger_Locked]
autoTrigger: if self.numberOfUnitsInEnemyTeam(withTag='targetLock',greaterThan=0,withinRange=50)
temporarilyAddTags: targetLockedFire
isVisible:false
buildSpeed: 0.5s


[action_trigger_unLocked]
autoTrigger: if self.numberOfUnitsInEnemyTeam(withTag='targetLock',lessThan=1,withinRange=500)
temporarilyRemoveTags: targetLockedFire
isVisible:false
buildSpeed: 0.5s






[action_fuelCUm]
isLocked:true
isVisible:if self.resource(type='fuel',greaterThan=0)
#isActive: false
text: Fuel
text_ru: Топливо
description: -
description_ru: -
iconImage:ROOT:/PNG/fuel_vert.png
addResources: fuel=1
price:  fuel=1

buildSpeed: 0s
pos: 0.1
displayRemainingStockpile: true
displayType: infoOnlyStockpile


[action_trigger_yarikblyat]
autoTrigger:if self.isFlying() and not self.isControlledByAI()
isVisible:false
addResources: fuel=-1

[action_trigger_yarikblyatrulinahui]
autoTrigger:if self.resource(type='fuel',lessThan=1)
isVisible:false
setUnitStats:maxTurnSpeed=0,moveSpeed=0,hp=-1
clearAllWaypoints:true






[action_trigger_yarikblyatrulinahuiuraaa]
autoTrigger:if self.resource(type='fuel',greaterThan=0)
isVisible:false
setUnitStats:maxTurnSpeed=${movement.maxTurnSpeed},moveSpeed=${movement.moveSpeed}

[hiddenAction_fuelIncoming]
autoTrigger:if not self.isFlying() and self.queueSize(lessThan=1) and self.hasParent(withTag="helipad")  and self.resource(type='fuel', greaterThan=0)
alsoQueueAction:LoadFuel

[hiddenAction_LoadFuel]
buildSpeed: 2
addResources: fuel=1




[action_trigger_Air]
autoTrigger: if self.isFlying()
temporarilyAddTags: air
isVisible:false
buildSpeed: 0.5s


[action_trigger_unAir]
autoTrigger: if not self.isFlying() 
temporarilyRemoveTags: air
isVisible:false



